 void rx_reset_float_state() {
+#if defined(__wasm__)
+	/* wasm rounds every f64 operation to nearest and has no notion of a rounding
+	 * mode, so the mode RandomX's CFROUND selects is kept in software here; see
+	 * ../../src/randomx_wasm_fp.hpp. */
+	rx_wasm_fp::reset_float_state();
+#else
 	setRoundMode_(FE_TONEAREST);
 	rx_set_double_precision(); //set precision to 53 bits if needed by the platform
+#endif
 }
 
 void rx_set_rounding_mode(uint32_t mode) {
+#if defined(__wasm__)
+	rx_wasm_fp::set_rounding_mode(mode);
+	return;
+#endif
 	switch (mode & 3) {
 	case RoundDown:
 		setRoundMode_(FE_DOWNWARD);
@@ -158,6 +173,9 @@ void rx_set_rounding_mode(uint32_t mode) {
 }
 
 uint32_t rx_get_rounding_mode() {
+#if defined(__wasm__)
+	return rx_wasm_fp::get_rounding_mode();
+#else
 	switch (fegetround()) {
 	case FE_DOWNWARD:
 		return RoundDown;
@@ -170,6 +188,7 @@ uint32_t rx_get_rounding_mode() {
 	default:
 		UNREACHABLE;
 	}
+#endif
 }
 
 #endif
