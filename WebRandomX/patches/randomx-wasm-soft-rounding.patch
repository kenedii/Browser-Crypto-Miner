+#endif
 	return x;
 }
 
 FORCE_INLINE rx_vec_f128 rx_sqrt_vec_f128(rx_vec_f128 a) {
 	rx_vec_f128 x;
+#if defined(__wasm__)
+	x.lo = rx_wasm_fp::fsqrt(a.lo);
+	x.hi = rx_wasm_fp::fsqrt(a.hi);
+#else
 	x.lo = rx_sqrt(a.lo);
 	x.hi = rx_sqrt(a.hi);
+#endif
 	return x;
 }
 
