 FORCE_INLINE rx_vec_f128 rx_mul_vec_f128(rx_vec_f128 a, rx_vec_f128 b) {
 	rx_vec_f128 x;
+#if defined(__wasm__)
+	x.lo = rx_wasm_fp::fmul(a.lo, b.lo);
+	x.hi = rx_wasm_fp::fmul(a.hi, b.hi);
+#else
