 	rx_vec_f128 x;
+#if defined(__wasm__)
+	x.lo = rx_wasm_fp::fdiv(a.lo, b.lo);
+	x.hi = rx_wasm_fp::fdiv(a.hi, b.hi);
+#else
 	x.lo = a.lo / b.lo;
